# Template Kubernetes Secret definition for MySQL credentials
# Note: Base64 encode values before populating (e.g. `echo -n 'rootpass' | base64`)
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: assignment3
type: Opaque
data:
  mysql_root_password: cm9vdHBhc3M=   # 'rootpass'
  mysql_user: Zmxhc2t1c2Vy          # 'flaskuser'
  mysql_password: Zmxhc2twYXNz      # 'flaskpass'
  mysql_database: Zmxhc2tkYg==        # 'flaskdb'
